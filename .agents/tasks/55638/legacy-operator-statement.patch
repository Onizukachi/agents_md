+!!!
+%html
+  %head
+    %meta{ charset: 'utf-8' }/
+    :css
+      @font-face {
+        font-family: 'PdfTimes';
+        font-weight: normal;
+        src: url('#{@statement.font_url('TimesNewRoman.ttf')}');
+      }
+      @font-face {
+        font-family: 'PdfTimes';
+        font-weight: bold;
+        src: url('#{@statement.font_url('TimesNewRomanBold.ttf')}');
+      }
+      body {
+        font-family: 'PdfTimes', 'Times New Roman', serif;
+        font-size: 14pt;
+        color: #000;
+        margin: 0;
