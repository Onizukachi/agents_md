diff --git a/spec/services/statement_templates/operator_statement_content_renderer_spec.rb b/spec/services/statement_templates/operator_statement_content_renderer_spec.rb
new file mode 100644
index 000000000..9119bcdb9
--- /dev/null
+++ b/spec/services/statement_templates/operator_statement_content_renderer_spec.rb
@@ -0,0 +1,214 @@
+# frozen_string_literal: true
+
+require 'spec_helper'
+
+RSpec.describe StatementTemplates::OperatorStatementContentRenderer do
+  subject(:content) { described_class.call(template: template, order: order) }
+
+  let(:customer) do
+    instance_double(
+      Customer,
+      surname: 'Иванов',
+      name: 'Иван',
+      patronymic: patronymic,
+      passport_number: '4510 123456',
+      internal_passport?: internal_passport
+    )
+  end
+  let(:patronymic) { 'Иванович' }
+  let(:internal_passport) { true }
+  let(:country) { instance_double(Place, name_ru: 'Турция', name_ru_form3: 'в Турцию') }
+  let(:supplier) { instance_double(OperatorOrganization, name: 'ООО «Анекс Туризм»') }
+  let(:package) do
+    instance_double(
+      Package,
+      detected_operator_organization: nil,
+      operator_organization: supplier,
+      country: country,
+      original_nights: 8,
+      nights_count: 7,
+      start_date: Date.new(2026, 10, 1),
+      end_date: Date.new(2026, 10, 9)
+    )
+  end
+  let(:booking_id) { 'ANX-123' }
+  let(:order) do
+    instance_double(Order, package: package, customer: customer, operator_booking_id: booking_id)
+  end
+
+  describe 'body variables' do
+    let(:template) do
+      '{{supplier_name}}|{{customer_name}}|{{passport_number}}|{{country_to}}|{{tour_nights}}|' \
+        '{{tour_start_date}}|{{tour_end_date}}|{{contract_number}}'
+    end
+
+    it 'renders the order data as text' do
+      expect(content).to eq(
+        'ООО «Анекс Туризм»|Иванов Иван Иванович|4510 123456|в Турцию|8 ночей|01.10.2026|09.10.2026|ANX-123'
+      )
+    end
+
+    context 'without the order data' do
+      let(:supplier) { nil }
+      let(:customer) { nil }
+      let(:country) { nil }
+      let(:booking_id) { nil }
+
+      before do
+        allow(package).to receive_messages(original_nights: nil, nights_count: nil, start_date: nil)
+        allow(package).to receive(:end_date).and_raise(NoMethodError, "undefined method '+' for nil")
+      end
+
+      it 'renders blanks to fill in by hand' do
+        expect(content).to eq(
+          "#{'_' * 30}|(ФИО)|#{'_' * 15}|#{'_' * 14}|____ ночей|#{'_' * 10}|#{'_' * 10}|#{'_' * 20}"
+        )
+      end
+    end
+  end
+
+  describe 'header fields' do
+    let(:template) do
+      '{{supplier_name_field}}|{{customer_name_field}}|{{passport_field}}|' \
+        '{{passport_with_issue_field}}|{{registration_address_field}}'
+    end
+    let(:blank_with_hint) do
+      '<span class="statement-blank">%<line>s<br><span class="statement-hint">%<hint>s</span></span>'
+    end
+
+    it 'renders the order data as text and blank lines for data we do NOT have' do
+      expect(content.split('|')).to eq(
+        [
+          'ООО «Анекс Туризм»',
+          'Иванов Иван Иванович',
+          '4510 123456',
+          "4510 123456, #{format(blank_with_hint, line: '_' * 30, hint: '(кем и когда выдан)')}",
+          '_' * 30
+        ]
+      )
+    end
+
+    context 'without the order data' do
+      let(:supplier) { nil }
+      let(:customer) { nil }
+
+      it 'renders blank lines with hints' do
+        expect(content.split('|')).to eq(
+          [
+            format(blank_with_hint, line: '_' * 30, hint: '(наименование туроператора)'),
+            format(blank_with_hint, line: '_' * 30, hint: '(ФИО заказчика)'),
+            format(blank_with_hint, line: '_' * 20, hint: '(серия номер внутреннего паспорта)'),
+            format(blank_with_hint, line: '_' * 35, hint: '(серия номер внутреннего паспорта, кем и когда выдан)'),
+            '_' * 30
+          ]
+        )
+      end
+    end
+  end
+
+  describe 'supplier name' do
+    let(:template) { '{{supplier_name_field}} {{supplier_name}}' }
+    let(:supplier) { instance_double(OperatorOrganization, name: 'ООО "Тур" & Co') }
+
+    it 'escapes HTML characters' do
+      expect(content).to eq('ООО &quot;Тур&quot; &amp; Co ООО &quot;Тур&quot; &amp; Co')
+    end
+  end
+
+  describe 'customer name' do
+    let(:template) { '{{customer_name_field}}|{{customer_name}}' }
+    let(:name_blanks) do
+      '<span class="statement-blank">______________________________<br>' \
+        '<span class="statement-hint">(ФИО заказчика)</span></span>|(ФИО)'
+    end
+
+    context 'when the customer has NO patronymic' do
+      let(:patronymic) { nil }
+
+      it 'renders the surname and the name' do
+        expect(content).to eq('Иванов Иван|Иванов Иван')
+      end
+    end
+
+    context 'when the customer name is in Latin' do
+      let(:customer) do
+        instance_double(
+          Customer,
+          surname: 'KONDRATOV',
+          name: 'ANDREI',
+          patronymic: nil,
+          passport_number: '751234567',
+          internal_passport?: false
+        )
+      end
+
+      it 'leaves blanks for the name to fill in by hand' do
+        expect(content).to eq(name_blanks)
+      end
+    end
+
+    context 'without a customer' do
+      let(:customer) { nil }
+
