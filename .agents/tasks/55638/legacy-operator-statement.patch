index 000000000..af538a15c
--- /dev/null
+++ b/app/pdfs/operator_statement_pdf.rb
@@ -0,0 +1,74 @@
+# frozen_string_literal: true
+
+# Заявление туроператору от имени заказчика: запрос, минимизация, претензия.
+#
+# Документ подаёт сам заказчик, поэтому бланка, подписанта и печати
+# организации в нём нет: только текст заявления и пустые «Дата» и «Подпись».
+class OperatorStatementPdf
+  TEMPLATE = 'orders/operator_statement'
+  FONTS_PATH = 'app/assets/fonts_pdf'
+  # Строка подчёркиваний — место для записи от руки; в заполняемом PDF это поле ввода
+  BLANK = /_{3,}/
+  BLANK_CHAR_WIDTH_EM = 0.5
+  # Абзац-подпись, под которым в заполняемом PDF стоит пустое многострочное поле;
+  # высота поля в мм — в data-height абзаца
+  FIELD_SELECTOR = 'p.statement-field'
+  DEFAULT_FIELD_HEIGHT_MM = 25
+
+  attr_reader :content
+
+  # fillable: подчёркивания и абзацы statement-field дополняются полями PDF-формы, которые клиент заполняет сам
+  def initialize(content:, fillable: false)
+    @content = content
+    @fillable = fillable
+  end
+
+  def render
+    options = { page_size: 'A4', enable_local_file_access: true }
+    options[:extra] = '--enable-forms' if @fillable
+    WickedPdf.new.pdf_from_string(html, options)
+  end
+
+  def body
+    return content unless @fillable
+
+    @field_number = 0
+    fragment = Nokogiri::HTML5.fragment(content)
+    fragment.css(FIELD_SELECTOR).each { |label| add_text_area(label) }
+    fragment.to_html.gsub(BLANK) { |blank| input(blank.length) }
+  end
+
+  def html
+    ApplicationController.render(
+      template: TEMPLATE,
+      formats: [:pdf],
+      layout: false,
+      assigns: { statement: self }
+    )
+  end
+
+  def font_url(name)
+    "file://#{Rails.root.join(FONTS_PATH, name)}"
+  end
+
+  private
+
+  def add_text_area(label)
+    label.add_class('statement-field-label')
+    label.add_next_sibling(%(<textarea name="#{field_name}" style="height: #{field_height(label)}mm;"></textarea>))
+  end
+
+  def input(blank_length)
+    %(<input type="text" name="#{field_name}" style="width: #{blank_length * BLANK_CHAR_WIDTH_EM}em;">)
+  end
+
+  # Поля PDF-формы с одним именем делят значение, поэтому у каждого своё имя
+  def field_name
+    "field_#{@field_number += 1}"
+  end
+
+  def field_height(label)
+    height = label['data-height'].to_i
+    height.positive? ? height : DEFAULT_FIELD_HEIGHT_MM
+  end
+end
