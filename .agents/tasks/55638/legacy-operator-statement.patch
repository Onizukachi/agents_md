diff --git a/app/services/statement_templates/operator_statement_content_renderer.rb b/app/services/statement_templates/operator_statement_content_renderer.rb
new file mode 100644
index 000000000..52c310272
--- /dev/null
+++ b/app/services/statement_templates/operator_statement_content_renderer.rb
@@ -0,0 +1,143 @@
+# frozen_string_literal: true
+
+require 'cgi'
+
+module StatementTemplates
+  # Заявление туроператору от имени заказчика: запрос, минимизация, претензия.
+  #
+  # Шаблон хранит документ целиком: шапку, тело и «Дата / Подпись». Поля шапки
+  # (`*_field`) подставляют значение, а без него — подчёркивания с подсказкой под ними.
+  # Переменные тела без значения подставляют место для записи от руки: подчёркивания
+  # примерной длины значения, для ФИО — «(ФИО)».
+  class OperatorStatementContentRenderer
+    AVAILABLE_VARIABLES = {
+      'supplier_name_field' => 'Шапка: юрлицо туроператора, без него — линия с подсказкой',
+      'customer_name_field' => 'Шапка: ФИО заказчика кириллицей, без него — линия с подсказкой',
+      'passport_field' => 'Шапка: внутренний паспорт заказчика, без него — линия с подсказкой',
+      'passport_with_issue_field' => 'Шапка претензии: внутренний паспорт и линия «кем и когда выдан»',
+      'registration_address_field' => 'Шапка: линия адреса регистрации',
+      'supplier_name' => 'Юрлицо туроператора',
+      'customer_name' => 'ФИО заказчика кириллицей, без него — «(ФИО)»',
+      'passport_number' => 'Внутренний паспорт заказчика',
+      'country_to' => 'Направление с предлогом («в Турцию»)',
+      'tour_nights' => 'Ночей в туре с перелётом («8 ночей»)',
+      'tour_start_date' => 'Дата начала тура',
+      'tour_end_date' => 'Дата окончания тура',
+      'contract_number' => 'Номер договора (номер заявки у туроператора)',
+    }.freeze
+
+    # Чем заменяется переменная тела без значения
+    BLANKS = {
+      'supplier_name' => '_' * 30,
+      'customer_name' => '(ФИО)',
+      'passport_number' => '_' * 15,
+      'country_to' => '_' * 14,
+      'tour_nights' => '____ ночей',
+      'tour_start_date' => '_' * 10,
+      'tour_end_date' => '_' * 10,
+      'contract_number' => '_' * 20,
+    }.freeze
+
+    # Поле шапки: из какой переменной берётся значение, длина пустой линии и подсказка под ней
+    HEADER_FIELDS = {
+      'supplier_name_field' => { value: 'supplier_name', blank: 30, hint: '(наименование туроператора)' },
+      'customer_name_field' => { value: 'customer_name', blank: 30, hint: '(ФИО заказчика)' },
+      'passport_field' => { value: 'passport_number', blank: 20, hint: '(серия номер внутреннего паспорта)' },
+      'registration_address_field' => { blank: 30 },
+    }.freeze
+
+    DATE_FORMAT = '%d.%m.%Y'
+
+    def self.call(template:, order:)
+      new(template: template, order: order).call
+    end
+
+    def initialize(template:, order:)
+      @template = template.to_s
+      @order = order
+    end
+
+    def call
+      header_variables.merge(body_variables).reduce(template) do |result, (key, value)|
+        result.gsub(/\{\{\s*#{Regexp.escape(key)}\s*\}\}/) { value }
+      end
+    end
+
+    private
+
+    attr_reader :template, :order
+
+    def values
+      @values ||= {
+        'supplier_name' => supplier_name,
+        'customer_name' => customer_name,
+        'passport_number' => passport_number,
+        'country_to' => country_to,
+        'tour_nights' => tour_nights,
+        'tour_start_date' => package.start_date&.strftime(DATE_FORMAT),
+        # Package#end_date без даты начала падает, а без неё и конец тура не нужен
+        'tour_end_date' => (package.end_date&.strftime(DATE_FORMAT) if package.start_date),
+        'contract_number' => order.operator_booking_id,
+      }
+    end
+
+    def body_variables
+      values.to_h { |key, value| [key, value.present? ? CGI.escapeHTML(value.to_s) : BLANKS.fetch(key)] }
+    end
+
+    def header_variables
+      fields = HEADER_FIELDS.transform_values do |field|
+        value = values[field[:value]]
+        value.present? ? CGI.escapeHTML(value.to_s) : blank(field[:blank], field[:hint])
+      end
+      fields.merge('passport_with_issue_field' => passport_with_issue_field)
+    end
+
+    # В претензии к паспорту нужно, кем и когда он выдан: этих данных у нас нет, их впишут от руки
+    def passport_with_issue_field
+      passport = values['passport_number']
+      return blank(35, '(серия номер внутреннего паспорта, кем и когда выдан)') if passport.blank?
+
+      "#{CGI.escapeHTML(passport)}, #{blank(30, '(кем и когда выдан)')}"
+    end
+
+    # Пустое поле — подчёркивания, под ними по центру подсказка
+    def blank(length, hint)
+      line = '_' * length
+      hint ? %(<span class="statement-blank">#{line}<br><span class="statement-hint">#{hint}</span></span>) : line
+    end
+
+    def package
+      @package ||= order.package
+    end
+
+    def supplier_name
+      (package.detected_operator_organization || package.operator_organization)&.name
+    end
+
+    # Только кириллицей: латиницей (как в загранпаспорте, без отчества) ФИО для заявления не годится, его впишут от руки
+    def customer_name
+      customer = order.customer
+      name = [customer&.surname, customer&.name, customer&.patronymic].filter_map { |part| part.to_s.strip.presence }
+      name.join(' ') if name.any? && name.join.match?(/\A[\p{Cyrillic}\s.'’-]+\z/)
+    end
+
+    # В заявлении нужен внутренний паспорт: номер загранпаспорта под ним был бы ошибкой
+    def passport_number
+      order.customer.passport_number if order.customer&.internal_passport?
+    end
+
+    def country_to
+      country = package.country
+      country&.name_ru_form3.presence || country&.name_ru.presence&.then { |name| "в #{name}" }
+    end
+
+    # Ночи тура целиком, с перелётом; в отеле их может быть меньше
+    def tour_nights
+      count = [package.original_nights, package.nights_count].find { |nights| nights.to_i.positive? }
+      return if count.blank?
+
+      "#{count} #{Russian.pluralize(count, 'ночь', 'ночи', 'ночей')}"
+    end
+  end
+end
